# Copy this file outside the repository and replace every image tag with the
# immutable digest printed in the matching GitHub Release.
CODEVAULT_SERVER_IMAGE=ghcr.io/codevault-llc/security/server@sha256:replace-me
CODEVAULT_WORKER_IMAGE=ghcr.io/codevault-llc/security/worker@sha256:replace-me
CODEVAULT_MEDIA_WORKER_IMAGE=ghcr.io/codevault-llc/security/media-worker@sha256:replace-me

# Use an absolute directory. Run `bun run production:secrets -- /path` to make
# the files with mode 0600. Do not place the directory in the repository.
CODEVAULT_SECRETS_DIR=/absolute/path/to/codevault-secrets

# The API binds to loopback. Put a TLS reverse proxy on the same host.
CODEVAULT_PORT=4310
SERVER_CORS_ORIGINS=
LOG_LEVEL=info

POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPU_LIMIT=2.0
OBJECTSTORE_MEMORY_LIMIT=1g
OBJECTSTORE_CPU_LIMIT=1.0
SERVER_MEMORY_LIMIT=1g
SERVER_CPU_LIMIT=1.0
WORKER_MEMORY_LIMIT=2g
WORKER_CPU_LIMIT=2.0
MEDIA_WORKER_MEMORY_LIMIT=256m
MEDIA_WORKER_CPU_LIMIT=1.0

