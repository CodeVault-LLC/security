{
  "name": "@codevault/media-worker",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun src/index.ts",
    "verify:runtime": "bun src/verify-runtime.ts",
    "build": "bun build src/index.ts --target=node --outdir=dist --format=esm --external sharp",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@codevault/core": "workspace:*",
    "@codevault/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "sharp": "0.35.3"
  },
  "exports": {
    "./claim-job": "./src/claim-job.ts",
    "./sanitize-image": "./src/sanitize-image.ts"
  }
}
