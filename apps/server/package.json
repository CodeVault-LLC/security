{
  "name": "@codevault/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=node --outdir=dist --format=esm",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@codevault/ai": "workspace:*",
    "@codevault/contracts": "workspace:*",
    "@codevault/core": "workspace:*",
    "@codevault/db": "workspace:*",
    "@codevault/reporting": "workspace:*",
    "@codevault/standards": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@node-rs/argon2": "^2.1.0",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "pg-boss": "^12.27.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./config": "./src/config.ts",
    "./reports": "./src/modules/reports/service.ts",
    "./services/storage": "./src/services/storage.ts",
    "./services/jobs": "./src/services/jobs.ts"
  }
}
