# CodeVault server configuration.
#
# Copy to .env for local development. Never commit a filled-in copy.
# Production processes also accept NAME_FILE=/run/secrets/name for the secret
# settings identified below. Set either NAME or NAME_FILE, never both.

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://codevault:codevault_dev_password@127.0.0.1:5433/codevault
# File-backed alternative: DATABASE_URL_FILE
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL=false

# --- Server ---------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=4310
# Comma-separated origins allowed to call the API. The desktop client uses its
# own application protocol, so this stays empty in a normal deployment.
SERVER_CORS_ORIGINS=
LOG_LEVEL=info

# --- Sessions -------------------------------------------------------------
# Comma-separated newest-first AES-256 keys. Each entry is id:base64, where
# base64 is the exact output from `openssl rand -base64 32` (44 characters,
# including its trailing `=`). Do not add whitespace. For example, generate a
# value with `openssl rand -base64 32`, then set: MFA_ENCRYPTION_KEYS=v1:<value>
# This example intentionally leaves the value unset; it must be supplied from
# a local secret or deployment secret manager.
MFA_ENCRYPTION_KEYS=
# File-backed alternative: MFA_ENCRYPTION_KEYS_FILE
# Lifetime of a session created with "Remember me".
SESSION_TTL_HOURS=168
INVITE_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# --- Object storage -------------------------------------------------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=codevault-artifacts
S3_ACCESS_KEY_ID=codevault
S3_SECRET_ACCESS_KEY=codevault_dev_password
# File-backed alternatives: S3_ACCESS_KEY_ID_FILE and S3_SECRET_ACCESS_KEY_FILE
# The development stack provisions a function-only PostgreSQL role and
# prefix-limited MinIO credentials for the media worker. Production must use
# separately managed credentials with the same least-privilege capabilities.
MEDIA_DATABASE_URL=postgres://codevault_media_login:codevault_media_dev_password@127.0.0.1:5433/codevault
MEDIA_S3_ACCESS_KEY_ID=codevault-media
MEDIA_S3_SECRET_ACCESS_KEY=codevault_media_dev_password
# File-backed alternatives: MEDIA_DATABASE_URL_FILE,
# MEDIA_S3_ACCESS_KEY_ID_FILE, and MEDIA_S3_SECRET_ACCESS_KEY_FILE
S3_FORCE_PATH_STYLE=true
# 10 GiB default; raise only with storage that can take it.
MAX_UPLOAD_BYTES=10737418240
PRESIGNED_URL_TTL_SECONDS=900

# --- Prior-art providers --------------------------------------------------
# Left blank, the provider is skipped and the check records that it was not run.
NVD_API_KEY=
GITHUB_ADVISORY_TOKEN=
# File-backed alternatives: NVD_API_KEY_FILE and GITHUB_ADVISORY_TOKEN_FILE
PRIOR_ART_USER_AGENT="CodeVault/1.0 (security research platform)"

# --- Gmail (disabled by default) ------------------------------------------
# Create a Google OAuth desktop/web client and register this exact callback.
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# File-backed alternative: GMAIL_CLIENT_SECRET_FILE
GMAIL_REDIRECT_URI=https://codevault.example/v1/mail/gmail/callback
# Comma-separated key-version:base64 entries. Each decoded key is 32 bytes.
# Generate with: openssl rand -base64 32
MAIL_TOKEN_KEYRING=
# File-backed alternative: MAIL_TOKEN_KEYRING_FILE
MAIL_ACTIVE_TOKEN_KEY_VERSION=1
# Optional push optimization. Configure all three or none; ten-minute polling
# remains authoritative when these are blank.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=
