{
  "name": "codevault",
  "version": "0.1.0-alpha.5",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "html-to-text": "10.0.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun run scripts/install-electron.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:services": "bun run scripts/dev.ts --only server,worker",
    "electron:install": "bun run scripts/install-electron.ts",
    "build": "bun run --filter '*' build",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:reset": "bun run scripts/db-reset.ts",
    "admin:create": "bun run scripts/bootstrap-admin.ts",
    "mfa:rotate-key": "bun run scripts/rotate-mfa-key.ts",
    "mcp:login": "bun run --cwd packages/mcp login",
    "mcp:start": "bun run --cwd packages/mcp start",
    "seed:dev": "bun run scripts/seed-dev.ts",
    "verify:env": "bun run scripts/verify-env.ts",
    "release:check-tag": "bun run scripts/release-evidence.ts check-tag",
    "release:verify": "bun run scripts/release-evidence.ts verify",
    "production:secrets": "bun run scripts/create-production-secrets.ts",
    "mail:rewrap-tokens": "bun run scripts/rewrap-mail-tokens.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^28.0.1",
    "openpgp": "6.3.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.14",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codevault/core": "workspace:*",
    "@codevault/db": "workspace:*",
    "@codevault/server": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4"
  }
}
