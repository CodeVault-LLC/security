{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": true,

    // Only Node's types are in scope. Without this, TypeScript loads every
    // @types package in the workspace — including React's, which needs the DOM
    // library this package deliberately does not have.
    "types": ["node"],

    // Playwright's declarations reference its Electron and browser APIs, which
    // need the DOM library this package does not load. Its own sources are
    // still checked in full; only third-party declarations are skipped.
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
